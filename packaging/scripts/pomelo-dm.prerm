#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# 移除前：如果現在用的是 Pomelo 登入畫面，先換回原本的登入管理員，免得下次開機沒有登入畫面。
# 不會停掉正在跑的 pomelo-dm（那會登出目前的使用者），重新開機後才換。
set -e
if [ "$1" = remove ] && [ "$(cat /etc/X11/default-display-manager 2>/dev/null)" = /usr/sbin/pomelo-dm ]; then
	/usr/sbin/pomelo-dm-switch off || echo "警告：找不到其他登入管理員，下次開機將沒有圖形登入畫面（可用文字登入後安裝 gdm3 或 lightdm）" >&2
fi
exit 0
