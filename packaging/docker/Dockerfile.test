# Pomelo 測試環境：編譯環境 + 虛擬螢幕 + 中文字型 + 一個測試帳號（密碼 pomelo123）
FROM pomelo-build
RUN apt-get update \
 && apt-get install -y --no-install-recommends xvfb xdotool imagemagick fonts-noto-cjk yaru-theme-icon \
      hicolor-icon-theme dbus-x11 libnotify-bin x11-utils \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash tester && echo 'tester:pomelo123' | chpasswd
