/* check-sec.c — 安全性檢查。
 * 不用權限的：安全性更新、防火牆、對網路開放的服務、SSH 設定、群組、自動登入、自動鎖定、磁碟加密、Secure Boot、
 *   AppArmor／SELinux、登入時自動執行的程式、可疑的程式、沒有密碼保護的 SSH 私鑰、家目錄權限。
 * 需要管理員權限的（flags 有 PM_CHK_ADMIN 才跑；經過 pkexec 執行 /usr/libexec/pomelo/pomelo-check-admin）：
 *   沒有密碼的帳號、老舊的密碼雜湊、sudo 免密碼、SSH 實際設定、不屬於任何套件的 setuid 程式、SSH 登入失敗次數。
 *   那支程式只輸出結論（帳號名稱、設定值），密碼雜湊與檔案內容不會離開它。 */
#define _GNU_SOURCE
#include "internal.h"
#include "check-int.h"
#include <ctype.h>
#include <dirent.h>
#include <grp.h>
#include <pwd.h>
#include <sys/stat.h>
#include <sys/sysmacros.h>
#include <time.h>

#define ADMIN_HELPER "/usr/libexec/pomelo/pomelo-check-admin"

/* ---- 對網路開放的服務（/proc/net/tcp、tcp6 的 LISTEN，不含只聽本機的） ---- */

typedef struct { int port; unsigned long inode; } Listen;

static int read_listen(const char *path, int v6, Listen *out, int n, int max)
{
	FILE *f = fopen(chk_path(path), "r");
	if (!f) return n;
	char line[512];
	if (!fgets(line, sizeof line, f)) { fclose(f); return n; }
	while (fgets(line, sizeof line, f) && n < max) {
		char local[64], st[8];
		unsigned long inode = 0;
		if (sscanf(line, "%*s %63s %*s %7s %*s %*s %*s %*s %*s %lu", local, st, &inode) < 2 || strcmp(st, "0A")) continue;
		char *colon = strrchr(local, ':');
		if (!colon) continue;
		*colon = 0;
		int port = (int)strtol(colon + 1, NULL, 16);
		/* 本機（127.x、::1、::ffff:127.x）不算 */
		if (!v6 && strlen(local) == 8 && !strcmp(local + 6, "7F")) continue;
		if (v6 && (!strcmp(local, "00000000000000000000000001000000") || (!strncmp(local, "0000000000000000FFFF0000", 24) && !strcmp(local + 30, "7F")))) continue;
		int dup = 0;
		for (int i = 0; i < n; i++) if (out[i].port == port) dup = 1;
		if (dup) continue;
		out[n].port = port;
		out[n].inode = inode;
		n++;
	}
	fclose(f);
	return n;
}

static const struct { int port, level; const char *name, *why; } known_ports[] = {
	{ 22, PM_CHK_INFO, "SSH", NULL },
	{ 3389, PM_CHK_INFO, N_("遠端桌面（RDP）"), NULL },
	{ 5900, PM_CHK_WARN, "VNC", N_("VNC 的密碼與畫面常常沒有加密") },
